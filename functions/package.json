{
  "name": "repair-cafe-functions",
  "version": "1.1.0",
  "description": "Cloud Functions for Repair Cafe Session Archiving, GDPR Redaction, and Volunteer Auth",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "manage-sessions": "npm run build && node lib/scripts/manageSessions.js",
    "ingest-history": "npm run build && node lib/scripts/ingestHistoricalData.js",
    "merge-volunteers": "npm run build && node lib/scripts/mergeVolunteers.js"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "uuid": "^11.1.1"
  },
  "private": true
}
